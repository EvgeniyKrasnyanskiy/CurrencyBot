# Telegram Bot Credentials & Channel
BOT_TOKEN=
ADMINS=[]
CHANNEL_ID=
TOPIC_ID=
SLEEP_TIME=600
CACHE_TTL=600

# Proxy Settings (enable only for local development if needed)
USE_PROXY=False
PROXY_HOST=127.0.0.1
PROXY_PORT=10808

# Moderation Settings
MODERATION_ENABLED=True
# If not set, CHANNEL_ID and TOPIC_ID are used by default
MODERATION_TARGET_GROUP_ID=
MODERATION_TARGET_THREAD_ID=

# Private Telegram channel ID for live moderation logs (e.g. -1001234567890)
MODERATION_LOG_CHANNEL_ID=

# Warning delay in seconds before deleting violation and bot warning reply
WARNING_DELETE_DELAY=60
# Announce rules once upon startup
WELCOME_MESSAGE_ENABLED=True
# Allow text replies from users to other users' ads (Default: False for strict board)
ALLOW_REPLIES_TO_ADS=False
# Max active ads per user per 24 hours (Default: 2)
MAX_ACTIVE_ADS_PER_USER=2
# Whitelist user IDs (in addition to ADMINS)
MODERATION_WHITELIST_USERS=[]